{
  "name": "examharness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "初中数学原创命题与组卷 · 构造优先 · 闸门链 · 教师终审",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "examharness": "./bin.js"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @examharness/client run build",
    "start": "pnpm build && node bin.js",
    "dev": "node --watch bin.js",
    "lint": "oxlint --deny-warnings packages test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && pnpm --filter @examharness/client run typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "tsc -b --clean",
    "dev:client": "pnpm --filter @examharness/client run dev"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-include": "^1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@examharness/core": "workspace:*",
    "@examharness/plugin-bank": "workspace:*",
    "@examharness/plugin-construct-parabola": "workspace:*",
    "@examharness/plugin-corpus": "workspace:*",
    "@examharness/plugin-figure": "workspace:*",
    "@examharness/plugin-graph": "workspace:*",
    "@examharness/plugin-llm": "workspace:*",
    "@examharness/plugin-paper": "workspace:*",
    "@examharness/plugin-verify-dedup": "workspace:*",
    "@examharness/plugin-verify-figure": "workspace:*",
    "@examharness/plugin-verify-roundtrip": "workspace:*",
    "@examharness/plugin-verify-scope": "workspace:*",
    "@examharness/plugin-verify-symbolic": "workspace:*",
    "@examharness/plugin-web": "workspace:*",
    "@examharness/plugin-workbench": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
