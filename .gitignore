# 依赖
node_modules/
.pnpm-store/
.venv/
venv/
__pycache__/
*.pyc

# 构建产物
dist/
build/
lib/
*.tsbuildinfo
client/dist/

# 运行期数据（绝不入库：会话、卷子、渲染产物、题库索引）
data/

# 运行时题型（agent 写的题型模块）：**要入库**——这是能力产出，不是数据
!constructors/
!constructors/**

# 语料（真实题库/教材整理件）：版权 + 体积，绝不入库；只保留说明
corpus/*
!corpus/README.md
*.local.yml
*.local.yaml
.env
.env.*

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# 工具写的临时目录（harness / 脚本可能生成，别提交）
*.tmpdir/
*.tmp

# 本地草稿
*.bak
*.old
scratch/
